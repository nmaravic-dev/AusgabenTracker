<Window x:Class="AusgabenTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ausgaben-Tracker" MinHeight="700" MinWidth="720" Height="700" Width="720"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Regular"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="Auto"/>  
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Expenses}"
                  SelectedItem="{Binding SelectedExpense}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="400"/>
                <DataGridTextColumn Header="Betrag"       Binding="{Binding Amount, StringFormat=C}" Width="Auto"/>
                <DataGridTextColumn Header="Kategorie"    Binding="{Binding CategoryName}" Width="Auto"/>
                <DataGridTextColumn Header="Datum"        Binding="{Binding Date, StringFormat=d}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox materialDesign:HintAssist.Hint="Beschreibung"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Margin="0,0,16,0"/>

            <TextBox materialDesign:HintAssist.Hint="Betrag"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Margin="0,0,16,0"/>

            <ComboBox materialDesign:HintAssist.Hint="Kategorie"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Name"
                      Width="150" Margin="0,0,16,0"/>

            <DatePicker materialDesign:HintAssist.Hint="Datum"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        SelectedDate="{Binding Date}"
                        Width="150"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Hinzufügen"
                    Command="{Binding AddExpenseCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,16,0"/>

            <Button Content="Löschen"
                    Command="{Binding DeleteExpenseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding TotalAmount, StringFormat='Gesamt: {0:C}'}"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>